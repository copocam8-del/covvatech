---
import '@fontsource-variable/inter';
import '@fontsource-variable/sora';
import '../styles/tokens.css';
import '../styles/base.css';
import { sitio, canales } from '../config/sitio';
// Tipografías del título y del texto (subconjunto latino) para precargarlas
import soraLatin from '@fontsource-variable/sora/files/sora-latin-wght-normal.woff2?url';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
  titulo?: string;
  descripcion?: string;
  /** false en páginas que no deben aparecer en buscadores (por ejemplo, la 404) */
  indexar?: boolean;
}

const { titulo = sitio.titulo, descripcion = sitio.descripcion, indexar = true } = Astro.props;

// La URL canónica y la imagen de Open Graph necesitan el dominio definitivo.
const base = sitio.url || Astro.site?.toString().replace(/\/$/, '') || '';
const canonica = base ? `${base}${Astro.url.pathname.replace(/index\.html$/, '')}` : undefined;
const imagenOg = base ? `${base}/og-covva.png` : '/og-covva.png';

// Datos estructurados para buscadores (schema.org)
const datosEstructurados = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: sitio.nombre,
  description: sitio.descripcion,
  ...(base && { url: `${base}/`, image: imagenOg, logo: `${base}/icon-512.png` }),
  ...(canales.correo.href && { email: sitio.contacto.email }),
  ...(canales.whatsapp.href && { telephone: `+${sitio.contacto.whatsapp}` }),
  ...(canales.instagram.href && { sameAs: [canales.instagram.href] }),
  knowsLanguage: 'es',
};
---

<!doctype html>
<html lang={sitio.idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    {indexar ? canonica && <link rel="canonical" href={canonica} /> : <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={sitio.colorTema} />
    <meta name="color-scheme" content="light" />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preload" href={soraLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />

    <!-- Open Graph / redes -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={sitio.nombre} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    {canonica && <meta property="og:url" content={canonica} />}
    <meta property="og:image" content={imagenOg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Covva: Sitios y sistemas que trabajan para tu negocio. Todos los días." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagenOg} />

    <!-- Marca que hay JavaScript disponible (las animaciones de aparición dependen de esto) -->
    <script is:inline>document.documentElement.classList.add('js');</script>

    {indexar && <script type="application/ld+json" set:html={JSON.stringify(datosEstructurados)} />}

    <slot name="head" />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <slot />
    <script>
      import { iniciarRevelar } from '../scripts/revelar';
      iniciarRevelar();
    </script>
  </body>
</html>
