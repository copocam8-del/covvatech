---
import HeroVisual from './HeroVisual.astro';
---

<section id="inicio" class="hero zona-oscura" aria-labelledby="hero-titulo">
  <div class="contenedor hero__grilla">
    <div class="hero__texto">
      <p class="hero__etiqueta">Consultora tecnológica · Desarrollo por suscripción</p>

      <h1 id="hero-titulo" class="hero__titulo">
        Sitios y sistemas que trabajan para tu negocio. <span>Todos los días.</span>
      </h1>

      <p class="hero__bajada">
        Diseñamos sitios, tiendas online y sistemas a medida para que tu negocio venda más y trabaje
        ordenado. Todo con una cuota mensual.
      </p>

      <div class="hero__acciones">
        <a href="#contacto" class="boton boton--primario">
          Solicitar presupuesto
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
        <a href="#servicios" class="boton boton--secundario">Conocer servicios</a>
      </div>
    </div>

    <div class="hero__visual">
      <HeroVisual />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding-top: calc(var(--nav-alto) + clamp(2.5rem, 6vw, 4.5rem));
    padding-bottom: clamp(4rem, 9vw, 6.5rem);
  }

  /* Fondo: una retícula muy tenue y un único resplandor violeta, contenido */
  .hero::before,
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .hero::before {
    background-image:
      linear-gradient(rgb(255 255 255 / 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    background-size: 56px 56px;
    background-position: center top;
    mask-image: radial-gradient(ellipse 70% 60% at 70% 45%, #000 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 70% 45%, #000 20%, transparent 75%);
  }

  .hero::after {
    background: radial-gradient(ellipse 45% 50% at 72% 48%, rgb(108 79 214 / 0.22), transparent 70%);
  }

  .hero__grilla {
    display: grid;
    gap: clamp(3rem, 8vw, 4rem);
    align-items: center;
  }

  .hero__texto {
    max-width: 38rem;
  }

  .hero__texto > * {
    animation: hero-entrar 0.9s var(--ease) both;
    /* --retraso-intro: tiempo extra mientras se ve la intro (ver Intro.astro) */
    animation-delay: var(--retraso-intro, 0s);
  }

  .hero__texto > :nth-child(2) { animation-delay: calc(var(--retraso-intro, 0s) + 0.06s); }
  .hero__texto > :nth-child(3) { animation-delay: calc(var(--retraso-intro, 0s) + 0.12s); }
  .hero__texto > :nth-child(4) { animation-delay: calc(var(--retraso-intro, 0s) + 0.18s); }
  .hero__texto > :nth-child(5) { animation-delay: calc(var(--retraso-intro, 0s) + 0.24s); }

  .hero__etiqueta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0.9rem 0.4rem 0.75rem;
    border: 1px solid rgb(201 184 248 / 0.22);
    border-radius: var(--radio-pill);
    color: var(--c-lila);
    font-size: var(--fs-sm);
    font-weight: 500;
  }

  .hero__etiqueta::before {
    content: '';
    flex-shrink: 0; /* el punto no se deforma si el texto ocupa dos líneas */
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c-violeta-claro);
    box-shadow: 0 0 0 4px rgb(132 103 232 / 0.2);
  }

  /* En pantallas angostas el texto no entra en una línea: se muestra sin el borde
     de píldora, como una etiqueta de texto con el punto alineado a la primera línea. */
  @media (max-width: 559.98px) {
    .hero__etiqueta {
      align-items: baseline;
      padding: 0 0 0 0.35rem;
      border: 0;
      border-radius: 0;
      line-height: 1.5;
    }

    .hero__etiqueta::before {
      position: relative;
      top: -0.1em;
    }
  }

  .hero__titulo {
    margin-block: 1.4rem 1.25rem;
    font-size: var(--fs-h1);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.04;
  }

  .hero__titulo span {
    color: var(--c-lila);
  }

  .hero__bajada {
    max-width: 34rem;
    color: var(--c-texto-oscuro-2);
    font-size: var(--fs-lg);
    line-height: 1.6;
  }

  .hero__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .hero__visual {
    min-width: 0;
  }

  @media (max-width: 479.98px) {
    .hero__acciones .boton {
      flex: 1 1 100%;
    }
  }

  @media (min-width: 960px) {
    .hero {
      min-height: min(100vh, 920px);
      display: flex;
      align-items: center;
    }

    .hero__grilla {
      grid-template-columns: 1fr 1.08fr;
      gap: 3rem;
    }
  }

  @keyframes hero-entrar {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
</style>
