---
import { Image } from 'astro:assets';
import logo from '../assets/brand/covva-logo.png';
import { navegacionVisible as navegacion } from '../data/visibilidad';
---

<header class="nav zona-oscura" data-nav>
  <div class="contenedor nav__barra">
    <a href="#inicio" class="nav__logo" aria-label="Covva, ir al inicio">
      <Image
        src={logo}
        alt=""
        width={104}
        height={56}
        densities={[1, 2, 3]}
        loading="eager"
        fetchpriority="high"
      />
    </a>

    <nav class="nav__menu" id="menu-principal" aria-label="Principal" data-menu>
      <ul role="list" class="nav__links">
        {
          navegacion.map((item) => (
            <li>
              <a href={`#${item.id}`} class="nav__link" data-nav-link={item.id}>
                {item.etiqueta}
              </a>
            </li>
          ))
        }
      </ul>
      <a href="#contacto" class="boton boton--primario nav__cta-movil">Solicitar presupuesto</a>
    </nav>

    <a href="#contacto" class="boton boton--primario boton--chico nav__cta">Solicitar presupuesto</a>

    <button
      type="button"
      class="nav__toggle"
      aria-expanded="false"
      aria-controls="menu-principal"
      data-menu-toggle
    >
      <span class="sr-only" data-menu-etiqueta>Abrir menú</span>
      <span class="nav__toggle-icono" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    /* Fondo opaco: el logo es un JPEG con fondo negro y necesita apoyarse
       sobre un negro sólido para integrarse sin recuadros visibles. */
    background: var(--c-negro);
    border-bottom: 1px solid transparent;
    transition:
      border-color var(--t-medio) ease,
      box-shadow var(--t-medio) ease;
  }

  /* Efecto al hacer scroll: línea inferior, sombra suave y barra más compacta */
  .nav.es-scroll {
    border-bottom-color: rgb(255 255 255 / 0.07);
    box-shadow: 0 10px 30px -12px rgb(8 7 13 / 0.45);
  }

  .nav__barra {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: var(--nav-alto);
    transition: height var(--t-medio) var(--ease);
  }

  .nav.es-scroll .nav__barra {
    height: var(--nav-alto-compacto);
  }

  .nav__logo {
    display: block;
    flex-shrink: 0;
    margin-right: auto;
    border-radius: var(--radio-sm);
  }

  .nav__logo img {
    width: 104px; /* +27 % respecto de la versión anterior */
    height: auto;
    /* Integra el fondo negro del logo (#030305 a #060409) con el del navbar (#08070D)
       sin modificar la imagen: "lighten" toma el más claro de los dos en cada píxel. */
    mix-blend-mode: lighten;
    transition: width var(--t-medio) var(--ease);
  }

  .nav.es-scroll .nav__logo img {
    width: 90px;
  }

  .nav__links {
    display: flex;
    gap: 0.25rem;
  }

  .nav__link {
    position: relative;
    display: block;
    padding: 0.5rem 0.85rem;
    color: var(--c-texto-oscuro-2);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    border-radius: var(--radio-sm);
    transition: color var(--t-rapido) ease;
  }

  .nav__link:hover,
  .nav__link[aria-current] {
    color: var(--c-blanco);
  }

  .nav__link::after {
    content: '';
    position: absolute;
    left: 0.85rem;
    right: 0.85rem;
    bottom: 0.2rem;
    height: 2px;
    border-radius: 2px;
    background: var(--c-violeta-claro);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--t-medio) var(--ease);
  }

  .nav__link[aria-current]::after {
    transform: scaleX(1);
  }

  .nav__cta-movil {
    display: none;
  }

  .nav__toggle {
    display: none;
  }

  /* ---------- Móvil y tablet ---------- */
  @media (max-width: 959.98px) {
    .nav__cta {
      display: none;
    }

    .nav__toggle {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      margin-right: -10px;
      background: transparent;
      border: 0;
      border-radius: var(--radio-sm);
      color: var(--c-blanco);
    }

    .nav__toggle-icono {
      position: relative;
      width: 22px;
      height: 14px;
    }

    .nav__toggle-icono span {
      position: absolute;
      left: 0;
      width: 100%;
      height: 2px;
      border-radius: 2px;
      background: currentColor;
      transition:
        transform var(--t-medio) var(--ease),
        opacity var(--t-rapido) ease;
    }

    .nav__toggle-icono span:nth-child(1) { top: 0; }
    .nav__toggle-icono span:nth-child(2) { top: 6px; }
    .nav__toggle-icono span:nth-child(3) { top: 12px; }

    .nav[data-abierto] .nav__toggle-icono span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
    .nav[data-abierto] .nav__toggle-icono span:nth-child(2) { opacity: 0; }
    .nav[data-abierto] .nav__toggle-icono span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

    .nav[data-abierto] {
      background: var(--c-negro);
      border-bottom-color: rgb(255 255 255 / 0.07);
    }

    .nav__menu {
      position: fixed;
      inset: var(--nav-alto) 0 0;
      display: flex;
      flex-direction: column;
      gap: 2rem;
      padding: 1.5rem var(--gutter) 2rem;
      background: var(--c-negro);
      overflow-y: auto;
      visibility: hidden;
      opacity: 0;
      transform: translateY(-8px);
      transition:
        opacity var(--t-medio) ease,
        transform var(--t-medio) var(--ease),
        visibility 0s linear var(--t-medio);
    }

    .nav.es-scroll .nav__menu {
      inset-block-start: var(--nav-alto-compacto);
    }

    .nav[data-abierto] .nav__menu {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition:
        opacity var(--t-medio) ease,
        transform var(--t-medio) var(--ease),
        visibility 0s;
    }

    .nav__links {
      flex-direction: column;
      gap: 0;
    }

    .nav__link {
      padding: 1rem 0;
      font-family: var(--f-titulos);
      font-size: 1.5rem;
      font-weight: 500;
      color: var(--c-blanco);
      border-bottom: 1px solid var(--c-borde-oscuro);
      border-radius: 0;
    }

    .nav__link::after {
      display: none;
    }

    .nav__link[aria-current] {
      color: var(--c-lila);
    }

    .nav__cta-movil {
      display: inline-flex;
      align-self: stretch;
    }
  }
</style>

<script>
  import { iniciarNavbar } from '../scripts/navbar';
  iniciarNavbar();
</script>
