---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import EncabezadoSeccion from './EncabezadoSeccion.astro';
import Icono from './Icono.astro';
import { proyectosReales } from '../data/visibilidad';
import { tieneDato } from '../config/sitio';

/*
 * Esta sección solo se incluye en la página cuando proyectos.json tiene al menos
 * un proyecto con nombre real (ver src/data/visibilidad.ts y src/pages/index.astro).
 */

// Todas las imágenes de src/assets/proyectos, indexadas por nombre de archivo
const archivos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/proyectos/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const imagenes = new Map(
  Object.entries(archivos).map(([ruta, mod]) => [ruta.split('/').pop()!, mod.default]),
);

const lista = proyectosReales.map((p) => {
  const estado = tieneDato(p.estado) ? p.estado.trim() : '';
  return {
    nombre: p.nombre,
    descripcion: tieneDato(p.descripcion) ? p.descripcion : '',
    categoria: tieneDato(p.categoria) ? p.categoria : '',
    estado,
    estadoClase: estado.toLowerCase() === 'publicado' ? 'publicado' : 'desarrollo',
    funciones: (p.funciones ?? []).filter((f) => tieneDato(f)),
    img: tieneDato(p.imagen) ? imagenes.get(p.imagen) : undefined,
    alt: tieneDato(p.imagenAlt) ? p.imagenAlt : `Imagen del proyecto ${p.nombre}`,
    enlace: tieneDato(p.enlace) ? p.enlace : '',
  };
});
---

<section id="proyectos" class="seccion proyectos" aria-labelledby="proyectos-titulo">
  <div class="contenedor">
    <EncabezadoSeccion etiqueta="Nuestro trabajo" titulo="Proyectos" id="proyectos-titulo">
      Productos propios que diseñamos y desarrollamos de punta a punta.
    </EncabezadoSeccion>

    <ul role="list" class="proy-grilla">
      {
        lista.map((p) => (
          <li class:list={['proy', { 'proy--enlace': p.enlace }]} data-revelar>
            <div class:list={['proy__imagen', { 'proy__imagen--vacia': !p.img }]}>
              {p.img ? (
                <>
                  {/* Fondo: la misma imagen, muy chica y desenfocada, para tomar sus colores */}
                  <Image src={p.img} alt="" class="proy__fondo" widths={[48]} sizes="48px" loading="lazy" aria-hidden="true" />
                  {/* La imagen completa, sin recortes (sirve para logos y para capturas) */}
                  <Image
                    src={p.img}
                    alt={p.alt}
                    class="proy__img"
                    widths={[220, 440]}
                    sizes="220px"
                    loading="lazy"
                  />
                </>
              ) : (
                <div class="proy__vacio" aria-hidden="true">
                  <Icono nombre="imagen" tamano={28} />
                </div>
              )}
            </div>

            <div class="proy__cuerpo">
              {(p.categoria || p.estado) && (
                <div class="proy__meta">
                  {p.categoria && <p class="proy__categoria">{p.categoria}</p>}
                  {p.estado && (
                    <p class:list={['proy__estado', `proy__estado--${p.estadoClase}`]}>
                      <span class="sr-only">Estado: </span>
                      {p.estado}
                    </p>
                  )}
                </div>
              )}
              <h3 class="proy__nombre">{p.nombre}</h3>
              {p.descripcion && <p class="proy__descripcion">{p.descripcion}</p>}

              {p.funciones.length > 0 && (
                <ul role="list" class="proy__funciones" aria-label={`Funciones de ${p.nombre}`}>
                  {p.funciones.map((f) => (
                    <li>
                      <Icono nombre="check" tamano={16} />
                      <span>{f}</span>
                    </li>
                  ))}
                </ul>
              )}

              {p.enlace && (
                <a class="proy__enlace" href={p.enlace} target="_blank" rel="noopener noreferrer">
                  Visitar sitio
                  <span class="sr-only">{p.nombre} (se abre en una pestaña nueva)</span>
                  <Icono nombre="externo" tamano={18} />
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .proyectos {
    background: var(--c-fondo-alt);
  }

  .proy-grilla {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .proy-grilla {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 960px) {
    .proy-grilla {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .proy {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--c-blanco);
    border: 1px solid var(--c-borde);
    border-radius: var(--radio-lg);
    overflow: hidden;
    transition:
      box-shadow var(--t-medio) ease,
      transform var(--t-medio) var(--ease);
  }

  /* Solo las tarjetas con enlace "se levantan" al pasar el mouse */
  .proy--enlace:hover {
    box-shadow: var(--sombra-tarjeta);
    transform: translateY(-3px);
  }

  .proy__imagen {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    background: #0b0a10;
    overflow: hidden;
    isolation: isolate;
  }

  /* Fondo desenfocado con los colores de la propia imagen */
  .proy__imagen :global(.proy__fondo) {
    position: absolute;
    inset: -25%;
    z-index: -1;
    width: 150%;
    height: 150%;
    object-fit: cover;
    filter: blur(28px) saturate(1.15);
    opacity: 0.75;
  }

  /* La imagen completa, centrada, con esquinas redondeadas como un ícono */
  .proy__imagen :global(.proy__img) {
    width: auto;
    height: 74%;
    max-width: 80%;
    object-fit: contain;
    border-radius: 18%;
    box-shadow: 0 10px 28px rgb(0 0 0 / 0.35);
    transition: transform 0.6s var(--ease);
  }

  .proy--enlace:hover .proy__imagen :global(.proy__img) {
    transform: scale(1.03);
  }

  /* Proyecto sin imagen: un fondo neutro de marca, sin marcas de "pendiente" */
  .proy__imagen--vacia {
    background: linear-gradient(160deg, var(--c-lila-tenue), #e2d9fb);
  }

  .proy__vacio {
    display: grid;
    place-items: center;
    height: 100%;
    color: #7f6fc9;
    opacity: 0.6;
  }

  .proy__cuerpo {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.4rem 1.5rem 1.6rem;
  }

  .proy__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 0.75rem;
  }

  .proy__categoria {
    color: var(--c-violeta);
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  .proy__estado {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.65rem;
    border-radius: var(--radio-pill);
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .proy__estado::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .proy__estado--publicado {
    background: var(--c-lila-tenue);
    color: var(--c-violeta-hover);
  }

  .proy__estado--publicado::before {
    background: var(--c-violeta);
  }

  .proy__estado--desarrollo {
    background: var(--c-fondo-alt);
    border: 1px solid var(--c-borde);
    color: var(--c-texto-2);
  }

  .proy__estado--desarrollo::before {
    border: 1.5px solid currentColor;
  }

  .proy__nombre {
    margin-bottom: 0.5rem;
    font-size: var(--fs-h3);
  }

  .proy__descripcion {
    color: var(--c-texto-2);
    margin-bottom: 1.25rem;
  }

  .proy__funciones {
    display: grid;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--c-borde);
    font-size: 0.9375rem;
  }

  .proy__funciones li {
    display: flex;
    gap: 0.55rem;
    align-items: flex-start;
  }

  .proy__funciones :global(svg) {
    flex-shrink: 0;
    margin-top: 0.25rem;
    color: var(--c-violeta);
  }

  .proy__enlace {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    align-self: flex-start;
    color: var(--c-violeta);
    font-weight: 600;
    text-decoration: none;
  }

  .proy__enlace:hover {
    color: var(--c-violeta-hover);
    text-decoration: underline;
  }

  /* Toda la tarjeta es clickeable cuando hay enlace */
  .proy__enlace::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .proy__enlace:focus-visible {
    box-shadow: none;
  }

  .proy:has(.proy__enlace:focus-visible) {
    box-shadow: var(--foco);
  }
</style>
