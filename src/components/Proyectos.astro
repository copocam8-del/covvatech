---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import EncabezadoSeccion from './EncabezadoSeccion.astro';
import Icono from './Icono.astro';
import { proyectosReales } from '../data/visibilidad';
import { tieneDato } from '../config/sitio';

/*
 * Esta sección solo se incluye en la página cuando proyectos.json tiene al menos
 * un proyecto con nombre real (ver src/data/visibilidad.ts y src/pages/index.astro).
 */

// Todas las imágenes de src/assets/proyectos, indexadas por nombre de archivo
const archivos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/proyectos/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const imagenes = new Map(
  Object.entries(archivos).map(([ruta, mod]) => [ruta.split('/').pop()!, mod.default]),
);

const lista = proyectosReales.map((p) => ({
  nombre: p.nombre,
  descripcion: tieneDato(p.descripcion) ? p.descripcion : '',
  categoria: tieneDato(p.categoria) ? p.categoria : '',
  img: tieneDato(p.imagen) ? imagenes.get(p.imagen) : undefined,
  enlace: tieneDato(p.enlace) ? p.enlace : '',
}));
---

<section id="proyectos" class="seccion proyectos" aria-labelledby="proyectos-titulo">
  <div class="contenedor">
    <EncabezadoSeccion etiqueta="Nuestro trabajo" titulo="Proyectos" id="proyectos-titulo">
      Una selección de proyectos que desarrollamos.
    </EncabezadoSeccion>

    <ul role="list" class="proy-grilla">
      {
        lista.map((p) => (
          <li class="proy" data-revelar>
            <div class:list={['proy__imagen', { 'proy__imagen--vacia': !p.img }]}>
              {p.img ? (
                <Image
                  src={p.img}
                  alt={`Vista del proyecto ${p.nombre}`}
                  widths={[400, 640, 960]}
                  sizes="(min-width: 960px) 380px, (min-width: 640px) 50vw, 100vw"
                  loading="lazy"
                />
              ) : (
                <div class="proy__vacio" aria-hidden="true">
                  <Icono nombre="imagen" tamano={28} />
                </div>
              )}
            </div>

            <div class="proy__cuerpo">
              {p.categoria && <p class="proy__categoria">{p.categoria}</p>}
              <h3 class="proy__nombre">{p.nombre}</h3>
              {p.descripcion && <p class="proy__descripcion">{p.descripcion}</p>}

              {p.enlace && (
                <a class="proy__enlace" href={p.enlace} target="_blank" rel="noopener noreferrer">
                  Ver proyecto
                  <span class="sr-only">{p.nombre} (se abre en una pestaña nueva)</span>
                  <Icono nombre="externo" tamano={18} />
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .proyectos {
    background: var(--c-fondo-alt);
  }

  .proy-grilla {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .proy-grilla {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 960px) {
    .proy-grilla {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .proy {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--c-blanco);
    border: 1px solid var(--c-borde);
    border-radius: var(--radio-lg);
    overflow: hidden;
    transition:
      box-shadow var(--t-medio) ease,
      transform var(--t-medio) var(--ease);
  }

  .proy:hover {
    box-shadow: var(--sombra-tarjeta);
    transform: translateY(-3px);
  }

  .proy__imagen {
    aspect-ratio: 16 / 10;
    background: var(--c-lila-tenue);
    overflow: hidden;
  }

  .proy__imagen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  .proy:hover .proy__imagen img {
    transform: scale(1.03);
  }

  /* Proyecto sin imagen: un fondo neutro de marca, sin marcas de "pendiente" */
  .proy__imagen--vacia {
    background: linear-gradient(160deg, var(--c-lila-tenue), #e2d9fb);
  }

  .proy__vacio {
    display: grid;
    place-items: center;
    height: 100%;
    color: #7f6fc9;
    opacity: 0.6;
  }

  .proy__cuerpo {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.4rem 1.5rem 1.6rem;
  }

  .proy__categoria {
    margin-bottom: 0.6rem;
    color: var(--c-violeta);
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  .proy__nombre {
    margin-bottom: 0.5rem;
    font-size: var(--fs-h3);
  }

  .proy__descripcion {
    color: var(--c-texto-2);
    margin-bottom: 1.5rem;
  }

  .proy__enlace {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    align-self: flex-start;
    color: var(--c-violeta);
    font-weight: 600;
    text-decoration: none;
  }

  .proy__enlace:hover {
    color: var(--c-violeta-hover);
    text-decoration: underline;
  }

  /* Toda la tarjeta es clickeable cuando hay enlace */
  .proy__enlace::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .proy__enlace:focus-visible {
    box-shadow: none;
  }

  .proy:has(.proy__enlace:focus-visible) {
    box-shadow: var(--foco);
  }
</style>
